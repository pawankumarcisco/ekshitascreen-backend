NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Render PostgreSQL: use the External URL locally and Internal URL on Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate two different cryptographically random values.
JWT_SECRET=replace-with-a-long-random-secret
DEVICE_KEY_SECRET=replace-with-a-different-long-random-secret

# ImageKit Developer options -> API keys.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Used only when creating the first database state.
ADMIN_NAME=EkshitaScreen Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
