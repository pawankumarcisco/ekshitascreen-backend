datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum ActivationStatus {
  PENDING
  ACTIVATED
  EXPIRED
  CANCELLED
}

enum PlaylistStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SyncStatus {
  PENDING
  DOWNLOADING
  VERIFYING
  APPLYING
  COMPLETED
  FAILED
}

enum PublishTargetStatus {
  QUEUED
  DOWNLOADING
  VERIFYING
  READY
  PLAYING
  FAILED
  SUPERSEDED
}

model DashboardUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(OPERATOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
}

model Device {
  id               String            @id @default(uuid())
  deviceUid        String            @unique
  deviceName       String?
  appVersion       String            @default("1.0.0")
  androidVersion   String?
  model            String?
  manufacturer     String?
  registered       Boolean           @default(false)
  registeredAt     DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  screen           Screen?
  activations      Activation[]
  syncs            DeviceSync[]
  heartbeats       DeviceHeartbeat[]
  credentials      DeviceCredential[]
  auditLogs        AuditLog[]
}

model Activation {
  id                String           @id @default(uuid())
  deviceId          String
  codeHash          String
  codeDisplaySuffix String?
  status            ActivationStatus @default(PENDING)
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime         @default(now())
  device            Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Screen {
  id            String               @id @default(uuid())
  deviceId      String               @unique
  name          String
  location      String?
  description   String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  device        Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  configuration ScreenConfiguration?
  playlists     Playlist[] @relation("ScreenPlaylists")
  assignedPlaylistId String?
  assignedPlaylist Playlist? @relation("AssignedPlaylist", fields: [assignedPlaylistId], references: [id], onDelete: Restrict)
  settingsGroupId String?
}

model ScreenConfiguration {
  id                   String   @id @default(uuid())
  screenId             String   @unique
  width                Int      @default(1920)
  height               Int      @default(1080)
  rotation             Int      @default(0)
  orientation          String   @default("LANDSCAPE")
  fitMode              String   @default("FIT")
  intervalSeconds      Int      @default(10)
  transition           String   @default("FADE")
  transitionDurationMs Int      @default(400)
  loop                 Boolean  @default(true)
  shuffle              Boolean  @default(false)
  autoStart            Boolean  @default(true)
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt
  screen               Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id           String         @id @default(uuid())
  originalName String
  storageKey   String         @unique
  mimeType     String
  fileSize     BigInt
  width        Int
  height       Int
  sha256       String
  createdAt    DateTime       @default(now())
  validFrom    DateTime?
  expiresAt    DateTime?
  autoDelete   Boolean        @default(false)
  cleanupGraceDays Int?
  deletedAt    DateTime?
  items        PlaylistItem[]
}

model Playlist {
  id          String         @id @default(uuid())
  screenId    String?
  version     Int
  status      PlaylistStatus @default(DRAFT)
  createdBy   String
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  ownerId     String?
  name        String?
  description String?
  libraryPlaylist Boolean    @default(false)
  loop        Boolean?
  shuffle     Boolean?
  validFrom   DateTime?
  expiresAt   DateTime?
  autoDelete  Boolean        @default(false)
  deletedAt   DateTime?
  screen      Screen?        @relation("ScreenPlaylists", fields: [screenId], references: [id], onDelete: Cascade)
  assignedScreens Screen[]   @relation("AssignedPlaylist")
  items       PlaylistItem[]

  @@unique([screenId, version])
}

model PlaylistItem {
  id              String     @id @default(uuid())
  playlistId      String
  mediaAssetId    String
  sortOrder       Int
  durationSeconds Int?
  enabled         Boolean    @default(true)
  validFrom       DateTime?
  expiresAt       DateTime?
  playlist        Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaAsset      MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([playlistId, sortOrder])
}

model ContentLayout {
  id              String   @id @default(uuid())
  ownerId         String
  name            String
  description     String?
  width           Int
  height          Int
  orientation     String
  backgroundColor String
  template        String
  zones           Json
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  @@index([ownerId, deletedAt])
}

model ContentSchedule {
  id              String   @id @default(uuid())
  ownerId         String
  name            String
  playlistId      String
  layoutId        String?
  screenIds       Json
  groupIds        Json
  targetScreenIds Json
  startDate       DateTime
  endDate         DateTime?
  weekdays        Json
  startTime       String
  endTime         String
  allDay          Boolean  @default(false)
  timezone        String
  priority        Int      @default(0)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  @@index([ownerId, enabled])
  @@index([playlistId])
}

model PlaybackSetting {
  id        String   @id @default(uuid())
  ownerId   String
  scope     String
  scopeId   String
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([scope, scopeId])
  @@index([ownerId, scope])
}

model CleanupRun {
  id          String   @id @default(uuid())
  status      String
  eligibleIds Json
  deletedIds  Json
  errors      Json
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

model DeviceSync {
  id             String     @id @default(uuid())
  deviceId       String
  targetVersion  Int
  appliedVersion Int?
  status         SyncStatus @default(PENDING)
  progress       Int        @default(0)
  errorMessage   String?
  startedAt      DateTime   @default(now())
  completedAt    DateTime?
  device         Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model DeviceHeartbeat {
  id               String   @id @default(uuid())
  deviceId         String
  lastSeenAt       DateTime @default(now())
  playbackStatus   String
  appliedVersion   Int
  freeStorageBytes BigInt?
  appVersion       String
  device           Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model DeviceCredential {
  id             String    @id @default(uuid())
  deviceId       String
  credentialHash String
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  device         Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String         @id @default(uuid())
  userId    String?
  deviceId  String?
  action    String
  details   Json
  createdAt DateTime       @default(now())
  user      DashboardUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  device    Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
}

model ScreenGroup {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdBy   String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     ScreenGroupMember[]

  @@index([ownerId, isActive])
}

model ScreenGroupMember {
  id        String      @id @default(uuid())
  groupId   String
  screenId  String
  createdBy String
  createdAt DateTime    @default(now())
  group     ScreenGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, screenId])
  @@index([screenId])
}

enum SettingsScope {
  COMMON
  GROUP
  SCREEN
}

enum SettingsDeliveryStatus {
  PENDING
  RECEIVED
  APPLYING
  APPLIED
  FAILED
}

model GeneralSettingsDraft {
  id        String        @id @default(uuid())
  ownerId   String
  scope     SettingsScope
  scopeId   String
  overrides Json
  updatedBy String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([ownerId, scope, scopeId])
}

model GeneralSettingsRevision {
  id          String        @id @default(uuid())
  ownerId     String
  scope       SettingsScope
  scopeId     String
  version     Int
  overrides   Json
  actorId     String
  publishedAt DateTime      @default(now())

  @@unique([ownerId, scope, scopeId, version])
}

model SettingsPublication {
  id             String   @id @default(uuid())
  ownerId        String
  revisionId     String
  idempotencyKey String
  actorId        String
  createdAt      DateTime @default(now())

  @@unique([actorId, idempotencyKey])
}

model DeviceSettingsState {
  id                      String                 @id @default(uuid())
  deviceId                String                 @unique
  publicationId           String
  desiredVersion          Int                    @default(0)
  receivedVersion         Int                    @default(0)
  appliedVersion          Int                    @default(0)
  status                  SettingsDeliveryStatus @default(PENDING)
  effectiveSettings       Json
  unsupportedCapabilities Json
  errorCode               String?
  errorMessage            String?
  lastSeenAt              DateTime?
  lastAppliedAt           DateTime?
  updatedAt               DateTime               @updatedAt
}

model PublishJob {
  id             String   @id @default(uuid())
  ownerId        String
  publisherId    String
  idempotencyKey String
  sourceScreenId String
  contentVersion Int
  playlistVersion Int
  groupSnapshots Json
  targetCount    Int
  createdAt      DateTime @default(now())
  targets        PublishJobTarget[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
}

model PublishJobTarget {
  id                    String              @id @default(uuid())
  jobId                 String
  screenId              String
  deviceId              String
  screenNameSnapshot    String
  targetVersion         Int
  playlistVersion       Int
  configurationVersion  Int
  configurationSnapshot Json
  manifestSnapshot      Json
  status                PublishTargetStatus @default(QUEUED)
  attemptId             String?
  attemptNumber         Int                 @default(1)
  totalBytes            BigInt
  totalFiles            Int
  bytesDownloaded       BigInt              @default(0)
  filesCompleted        Int                 @default(0)
  progressPercent       Int                 @default(0)
  activeVersion         Int?
  previousActiveVersion Int?
  lastProgressAt        DateTime
  errorCode             String?
  errorMessage          String?
  createdAt             DateTime            @default(now())
  job                   PublishJob          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attempts              PublishAttempt[]

  @@unique([jobId, screenId])
  @@index([screenId, targetVersion])
  @@index([jobId, status])
  @@index([deviceId, status])
}

model PublishAttempt {
  id               String              @id @default(uuid())
  targetId         String
  number           Int
  status           PublishTargetStatus @default(QUEUED)
  eventSequence    BigInt              @default(0)
  bytesDownloaded BigInt              @default(0)
  totalBytes       BigInt
  filesCompleted   Int                 @default(0)
  totalFiles       Int
  progressPercent  Int                 @default(0)
  currentFile      String?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime            @default(now())
  completedAt      DateTime?
  target           PublishJobTarget    @relation(fields: [targetId], references: [id], onDelete: Restrict)
  events           PublishEvent[]

  @@unique([targetId, number])
}

model PublishEvent {
  id            String              @id @default(uuid())
  eventId       String
  attemptId     String
  eventSequence BigInt
  status        PublishTargetStatus
  details       Json
  createdAt     DateTime            @default(now())
  attempt       PublishAttempt      @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([attemptId, eventId])
  @@unique([attemptId, eventSequence])
}
